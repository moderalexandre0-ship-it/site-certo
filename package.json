{
  "name": "nexospay",
  "version": "0.1.0",
  "private": true,
  "description": "NexosPay - Discord sales automation with web panel, backend and Mercado Pago integration.",
  "main": "backend/src/app.js",
  "scripts": {
    "start": "node backend/src/app.js",
    "bot": "node bot/index.js",
    "start:all": "start \"NexosPay Backend\" cmd /k \"npm start\" & start \"NexosPay Bot\" cmd /k \"npm run bot\"",
    "dev": "nodemon backend/src/app.js",
    "db:init": "node backend/src/scripts/initDatabase.js"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "discord.js": "^14.13.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "mysql2": "^3.6.0",
    "passport": "^0.6.0",
    "passport-discord": "^0.1.4",
    "sequelize": "^6.37.8",
    "uuid": "^9.0.1",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
